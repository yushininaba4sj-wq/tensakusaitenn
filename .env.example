# サイトURL（本番）
NEXT_PUBLIC_SITE_URL=https://goukakulink.vercel.app

# SENPAI LINK と同じ Supabase プロジェクトの値を設定すると、
# 同じメールアドレス・パスワードでログインできます。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Dashboard → Authentication → URL Configuration に以下を追加:
# - Site URL: https://goukakulink.vercel.app
# - Redirect URLs: https://goukakulink.vercel.app/auth/callback

# テーブル作成: supabase/schema.sql を SQL Editor で実行

# 運営通知（Slack）— SENPAI LINK API 経由で通知できない場合のフォールバック
# SENPAI LINK と同じ Incoming Webhook URL を設定してください
OPS_SLACK_WEBHOOK_URL=
# SENPAI_LINK_ORIGIN=https://senpailink.vercel.app

# 運営ログインで許可するメールアドレス（カンマ区切り）
# 例: OPERATOR_ALLOWED_EMAILS=ops@example.com,admin@example.com
OPERATOR_ALLOWED_EMAILS=
